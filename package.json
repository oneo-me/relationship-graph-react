{
  "name": "relationship-graph-react",
  "version": "0.1.0",
  "description": "Interactive canvas force-directed relationship graph for React. A 1:1 port of the Locus knowledge graph renderer.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && bun run scripts/copy-css.ts",
    "dev": "vite build --watch",
    "example:install": "bun install --cwd example",
    "example:dev": "bun run build && bun run --cwd example dev",
    "example:build": "bun run build && bun run --cwd example build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "keywords": [
    "react",
    "graph",
    "force-directed",
    "canvas",
    "knowledge-graph",
    "d3"
  ],
  "engines": {
    "node": ">=20"
  }
}
